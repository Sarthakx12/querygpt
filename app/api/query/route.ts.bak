import { NextResponse } from "next/server";
import type { ApiResponse, QueryRequest } from "@/lib/types";
import { askGemini } from "@/lib/llm";
import { runQuery } from "@/lib/db";
import { validateSql } from "@/lib/safety";

export async function POST(request: Request) {
  let body: QueryRequest;
  try {
    body = (await request.json()) as QueryRequest;
  } catch {
    return NextResponse.json<ApiResponse>(
      { kind: "error", message: "Invalid request body." },
      { status: 400 }
    );
  }

  const { question, history } = body;

  if (!question || typeof question !== "string") {
    return NextResponse.json<ApiResponse>(
      { kind: "error", message: "Question is required." },
      { status: 400 }
    );
  }

  try {
    let llmResponse = await askGemini(question, history);

    if (llmResponse.needs_clarification) {
      return NextResponse.json<ApiResponse>({
        kind: "clarify",
        question: llmResponse.clarification_question || "Please provide more details.",
      });
    }

    if (!llmResponse.sql) {
      return NextResponse.json<ApiResponse>({
        kind: "error",
        message: "LLM failed to generate SQL.",
      });
    }

    let retried = false;
    let finalSql = llmResponse.sql;
    let queryResult;

    // Safety Check 1
    const validation = validateSql(finalSql);
    if (!validation.safe) {
      return NextResponse.json<ApiResponse>({
        kind: "blocked",
        message: validation.reason || "Unsafe SQL detected.",
      });
    }

    try {
      queryResult = runQuery(finalSql);
    } catch (dbError: any) {
      // Retry once with error feedback
      retried = true;
      llmResponse = await askGemini(question, history, dbError.message);
      
      if (llmResponse.needs_clarification) {
        return NextResponse.json<ApiResponse>({
          kind: "clarify",
          question: llmResponse.clarification_question || "Please provide more details.",
        });
      }

      if (!llmResponse.sql) {
        return NextResponse.json<ApiResponse>({
          kind: "error",
          message: `SQL failed and retry didn't provide new SQL: ${dbError.message}`,
        });
      }

      finalSql = llmResponse.sql;
      // Safety Check 2 (on retry)
      const validationRetry = validateSql(finalSql);
      if (!validationRetry.safe) {
        return NextResponse.json<ApiResponse>({
          kind: "blocked",
          message: validationRetry.reason || "Unsafe SQL detected on retry.",
        });
      }

      queryResult = runQuery(finalSql);
    }

    return NextResponse.json<ApiResponse>({
      kind: "result",
      answer: llmResponse.explanation || "Here are the results.",
      sql: finalSql,
      columns: queryResult.columns,
      rows: queryResult.rows,
      rowCount: queryResult.rows.length,
      ms: queryResult.ms,
      retried: retried,
      chart: llmResponse.result_type === "chart" ? (llmResponse.chart?.type || "bar") : "none",
    });

  } catch (error: any) {
    console.error("Pipeline Error:", error);
    return NextResponse.json<ApiResponse>({
      kind: "error",
      message: error.message || "An unexpected error occurred in the pipeline.",
    });
  }
}
